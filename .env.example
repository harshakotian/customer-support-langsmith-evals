# Copy this file to .env beside Evaluations_Using_LangSmith_Customer_Support.ipynb.
# Replace the two API-key placeholders locally. Never commit your real .env.
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=replace_with_your_langsmith_api_key
OPENAI_API_KEY=replace_with_your_openai_api_key

# Use the endpoint appropriate to your LangSmith account.
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_PROJECT=customer-support-intent-evals
LANGSMITH_DATASET=customer-support-intents-100-v1

# Notebook model and evaluation settings
CLASSIFIER_MODEL=gpt-4o-mini
JUDGE_MODEL=gpt-4o-mini
MAX_CONCURRENCY=4
# The current standalone notebook uses a fixed 2500 ms latency threshold.
LATENCY_SLA_MS=2500

# Cost-estimate assumptions, not verified current prices.
# Update these to the applicable rates for your configured model.
INPUT_USD_PER_MILLION=0.15
OUTPUT_USD_PER_MILLION=0.60
